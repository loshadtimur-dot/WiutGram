# Wiutgram environment variables.
# Copy to .env and fill in values for your server.

# HTTP port
PORT=3000

# Secret used to sign session tokens and encrypt 2FA secrets.
# Generate with: openssl rand -hex 48
# If unset, the app creates data/secret.txt on first start.
JWT_SECRET=

# SQLite database file (default: data/app.db)
UNI_DB_FILE=data/app.db

# Uploaded files directory (default: uploads/)
UPLOADS_DIR=uploads

# Trust proxy: number of proxies in front of the app, "true", or "false".
# Behind nginx/Caddy use 1 so rate limits and IPs work correctly.
TRUST_PROXY=1

# production enables secure cookies and expects HTTPS
NODE_ENV=production

# Public site URL, used for absolute links (sitemap.xml, email links).
# On Railway set it to the generated domain, without a trailing slash.
APP_URL=https://wiutgram.up.railway.app

# Email delivery for address confirmation (HTTPS API, no SMTP ports).
# Fill in only one provider. Without a key, registration skips confirmation.
RESEND_API_KEY=
BREVO_API_KEY=
MAIL_FROM=Wiutgram <noreply@wiutgram.up.railway.app>
# MAIL_DEBUG=1 prints letters to the server log instead of sending them.
MAIL_DEBUG=0
