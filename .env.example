# UNI Lovers environment variables.
# Copy to .env and fill in values for your server.

# HTTP port
PORT=3000

# Secret used to sign session tokens and encrypt 2FA secrets.
# Generate with: openssl rand -hex 48
# If unset, the app creates data/secret.txt on first start.
JWT_SECRET=

# SQLite database file (default: data/app.db)
UNI_DB_FILE=data/app.db

# Uploaded files directory (default: uploads/)
UPLOADS_DIR=uploads

# Trust proxy: number of proxies in front of the app, "true", or "false".
# Behind nginx/Caddy use 1 so rate limits and IPs work correctly.
TRUST_PROXY=1

# production enables secure cookies and expects HTTPS
NODE_ENV=production
