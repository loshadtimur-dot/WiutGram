# /etc/caddy/Caddyfile
#
# Domain and ACME email come from the Caddy environment
# (/etc/caddy/caddy.env or `systemctl edit caddy`):
#   SITE_DOMAIN=uni-lovers.uz
#   ACME_EMAIL=admin@uni-lovers.uz
#
# Caddy obtains and renews the HTTPS certificate automatically.

{
	email {$ACME_EMAIL:admin@example.com}
	admin off
}

# Redirect www to the bare domain.
www.{$SITE_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}

{$SITE_DOMAIN} {
	encode zstd gzip

	# Banner uploads are capped at 8 MB in the app; leave headroom for the form.
	request_body {
		max_size 16MB
	}

	reverse_proxy 127.0.0.1:3000 {
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
		header_up X-Real-IP {remote_host}
	}

	# Versioned static assets can be cached forever.
	@static path /css/* /js/* /img/*
	header @static Cache-Control "public, max-age=31536000, immutable"

	# HTML is always revalidated so a deploy is visible immediately.
	@html path / /index.html
	header @html Cache-Control "no-cache"

	# The owner area must never be indexed.
	@admin path /admin /admin/* /api/admin/* /api/admin
	header @admin X-Robots-Tag "noindex, nofollow, noarchive"

	@media path /media/*
	header @media Cache-Control "private, max-age=600"
	header @media X-Robots-Tag "noindex, noimageindex"
	header @media X-Content-Type-Options "nosniff"

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	log {
		output file /var/log/caddy/uni-lovers.log {
			roll_size 20mb
			roll_keep 5
		}
		format console
	}
}
