# /etc/uni-lovers/uni-lovers.env
# Copy this file, fill in the values, then:
#   chown root:unilovers /etc/uni-lovers/uni-lovers.env
#   chmod 0640 /etc/uni-lovers/uni-lovers.env
# Never commit the real file.

# --- Core ---
NODE_ENV=production
PORT=3000
# One reverse proxy (Caddy) in front of the app.
TRUST_PROXY=1

# Public origin, used in emails and links. No trailing slash.
SITE_URL=https://example.com
APP_URL=https://example.com

# --- Secrets ---
# 48+ random bytes: openssl rand -hex 48
JWT_SECRET=
# The app stores the generated secret in data/secret.txt when JWT_SECRET is empty.

# --- Storage ---
UNI_DB_FILE=/srv/uni-lovers/data/app.db
UPLOADS_DIR=/srv/uni-lovers/uploads
MEDIA_DIR=/srv/uni-lovers/storage
BACKUP_DIR=/srv/uni-lovers/backups

# --- Backups and alerts ---
KEEP_DAILY=7
KEEP_WEEKLY=4
KEEP_MONTHLY=3
# Optional off-site copy: rclone remote or scp destination (user@host:/path).
RCLONE_REMOTE=
BACKUP_SCP_TARGET=
# Optional encryption of off-site copies: age public key.
AGE_RECIPIENT=

# Telegram bot for alerts and the weekly summary.
# Create a bot with @BotFather, get your chat id from @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Reserved for the next stages (not read by the app yet) ---
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Wiutgram <no-reply@example.com>"
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com
